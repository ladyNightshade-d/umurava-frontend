# Custom Backend API Configuration
# Copy this file to .env.local and fill in your actual values

# Full API URL including /api suffix
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api

# Base backend URL (without /api) — used for OAuth redirects
# Must be set explicitly to avoid fragile string manipulation
NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com

# NOTE: Both variables must use HTTPS in production (never HTTP)
